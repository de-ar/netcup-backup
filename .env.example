# netcup OAuth2
NETCUP_REFRESH_TOKEN=
NETCUP_SERVER_ID=
NETCUP_KEEP=1

# Snapshot schedule (UTC). Online snapshots only — no downtime.
BACKUP_CRON=0 3 * * *

# SSH to the RS 2000 G12
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PRIVATE_KEY=
SSH_HOST_KEYS=

# Restic on the RS 2000
RESTIC_BIN=/usr/local/bin/restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_PATHS=/
RESTIC_EXCLUDE=/tmp,/proc,/sys,/run,/var/cache

# R2 credentials (consumed by restic on the RS 2000)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# Restic retention + prune
R2_KEEP=4
RESTIC_CRON=30 3 * * *
PRUNE_CRON=0 4 * * 0

# HTTP health endpoint
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Logging
LOG_LEVEL=INFO
TZ=Europe/Berlin
